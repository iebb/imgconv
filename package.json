{
  "name": "resz-im",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy dist --project-name imgconv --branch master",
    "test": "vite --host 127.0.0.1 --open /tests/runner.html",
    "test:locales": "tsx --test tests/i18n.test.ts",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "test:unit": "tsx --test tests/i18n.test.ts tests/settings.test.ts"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "heic-to": "^1.3.0",
    "onnxruntime-web": "^1.23.2",
    "upng-js": "^2.1.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.0"
  }
}
